<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_margin="@dimen/_10dp"
        app:cardCornerRadius="@dimen/_10dp"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/llayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10dp"
            android:background="@color/white"
            android:orientation="vertical">


            <TextView
                android:id="@+id/txtActivitiesID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_2dp"
                android:layout_marginTop="@dimen/_5dp"
                android:text="Activities !"
                android:textColor="@color/colorButton"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/txtCrop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtActivitiesID"
                android:layout_toEndOf="@+id/imgView"
                android:layout_toRightOf="@+id/imgView"
                android:padding="@dimen/_2dp"
                android:layout_marginTop="@dimen/_5dp"
                android:text="Crop"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sp" />


            <TextView
                android:id="@+id/txtCropName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtCrop"
                android:layout_toEndOf="@+id/imgView"
                android:layout_toRightOf="@+id/imgView"
                android:text="CropName"
                android:textColor="@color/colorButton"
                android:textSize="@dimen/_15sp" />

            <TextView
                android:id="@+id/txtStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtCropName"
                android:padding="@dimen/_2dp"
                android:layout_marginTop="@dimen/_5dp"
                android:text="Start Date"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sp" />

            <LinearLayout
                android:id="@+id/llDate"
                android:layout_width="match_parent"
                android:layout_below="@+id/txtStart"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/txtStartDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="12-01-2019 : 08:40:45"
                    android:textColor="@color/colorButton"
                    android:textSize="@dimen/_15sp" />

                <TextView
                    android:id="@+id/txtEndDate"
                    android:layout_width="0dp"
                    android:gravity="end"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="12-01-2019 : 08:40:45"
                    android:textColor="@color/colorButton"
                    android:textSize="@dimen/_15sp"
                    />

            </LinearLayout>





            <TextView
                android:id="@+id/txtEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtCropName"
                android:padding="@dimen/_2dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_5dp"
                android:text="End Date"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sp"
                android:layout_alignParentRight="true" />

            <TextView
                android:id="@+id/txtParticipation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llDate"
                android:padding="@dimen/_2dp"
                android:layout_marginTop="@dimen/_5dp"
                android:text="Participation/Validation"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sp" />


            <TextView
                android:id="@+id/txtParticipationPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtParticipation"
                android:text="12 Jul "
                android:textColor="@color/colorButton"
                android:textSize="@dimen/_15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:layout_below="@+id/txtParticipationPercentage"
                android:layout_width="wrap_content"
                android:layout_margin="@dimen/_10dp"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</layout>