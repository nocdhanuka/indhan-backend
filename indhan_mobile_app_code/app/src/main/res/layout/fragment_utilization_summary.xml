<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <LinearLayout
        android:id="@+id/llProductCrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/txtFilterCrop"
            style="?android:listSeparatorTextViewStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_weight="1"
            android:background="@drawable/input_border_green"
            android:drawableRight="@drawable/downarrow"
            android:drawablePadding="@dimen/_5dp"
            android:hint="Select Crop"
            android:maxLines="1"
            android:minLines="1"
            android:padding="@dimen/_5sdp"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textColorHint="@color/darkgray"
            android:textSize="@dimen/_12sdp"
            android:textStyle="normal" />

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/txtFilterProduct"
            style="?android:listSeparatorTextViewStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_weight="1"
            android:background="@drawable/input_border_green"
            android:drawableRight="@drawable/downarrow"
            android:drawablePadding="@dimen/_5dp"
            android:hint="Select product"
            android:maxLines="1"
            android:minLines="1"
            android:padding="@dimen/_5sdp"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textColorHint="@color/darkgray"
            android:textSize="@dimen/_12sdp"
            android:textStyle="normal" />

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUtilizationSummary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_4sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnReset" />

    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/txtAsmFilter"
        style="?android:listSeparatorTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_weight="1"
        android:background="@drawable/input_border_green"
        android:drawableRight="@drawable/downarrow"
        android:drawablePadding="@dimen/_5dp"
        android:hint="Select ASM"
        android:maxLines="1"
        android:minLines="1"
        android:padding="@dimen/_5sdp"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textColorHint="@color/darkgray"
        android:textSize="@dimen/_12sdp"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@+id/llProductCrop" />

    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="@dimen/_8sdp"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/_4sdp"
        android:paddingEnd="@dimen/_4sdp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/txtAsmFilter"
        android:background="@drawable/button_selector"
        android:padding="@dimen/_5sdp"
        android:text="Reset"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black" />

    <com.dhanuka.indhan.Fonts.Medium
        android:id="@+id/tvNoData"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="No Data Found"
        android:textAlignment="center"
        android:textColor="@color/progess_green"
        android:visibility="gone"
        android:textSize="@dimen/_16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>