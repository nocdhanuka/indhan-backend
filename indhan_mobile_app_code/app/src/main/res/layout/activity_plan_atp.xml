<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    android:orientation="vertical"
    android:weightSum="12">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:elevation="@dimen/_10sdp">

            <LinearLayout
                android:id="@+id/iCross"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                tools:ignore="DuplicateIds">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_arrow_back"
                    android:padding="@dimen/_10sdp" />

            </LinearLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/pd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_toRightOf="@+id/iCross"
                android:text="Plan ATP"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15sdp" />

            <!--<LinearLayout
                 android:id="@+id/exportdb_btn"
                 android:layout_width="@dimen/_50sdp"
                 android:layout_height="@dimen/_50sdp"
                 android:layout_alignParentRight="true"
                 android:layout_centerInParent="true"
                 android:gravity="center">
                 <ImageView
                      android:adjustViewBounds="true"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:background="@drawable/tick_white"
                      android:padding="@dimen/_10sdp" />
            </LinearLayout>-->


        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/llNestedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.5"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorAccent"
                        android:padding="@dimen/_5sdp"
                        android:text="month"
                        android:textColor="@color/White"
                        android:textSize="@dimen/_15sdp" />


                    <noman.weekcalendar.WeekCalendar
                        android:id="@+id/calendar"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        app:dayNameLength="threeLetters"
                        app:daysBackgroundColor="@color/AppWhite"
                        app:daysTextColor="@color/black"
                        app:numOfPages="80"
                        app:todaysDateBgColor="@color/cardview_shadow_end_color"
                        app:weekBackgroundColor="@color/AppWhite"
                        app:weekTextColor="@color/black"
                        app:weekTextSize="@dimen/_10sdp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_10sdp"
                android:paddingLeft="@dimen/_10sdp">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="DD Name"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_dd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select DD"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Types of Meeting"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_data_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Type"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvPresenterLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:visibility="gone"
                    android:text="Select Presenter"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_presenter_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Presenter"
                    android:textColor="@color/black" />

                <View
                    android:id="@+id/viewPresenter"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:visibility="gone"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvMonitorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Select Monitor"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_monitor_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Monitor"
                    android:textColor="@color/black" />

                <View
                    android:id="@+id/viewMonitor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:visibility="gone"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Language"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinnerLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Language"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />



                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="Crop"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_crop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Crop"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="Product"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_Product"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Product"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <LinearLayout
                    android:id="@+id/crop_two_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:focusable="true"
                        android:text="@string/product_two"
                        android:textColor="@color/darkgray" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinner_Product_one"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:drawableRight="@drawable/downarrow"
                        android:text="@string/select_product_two"
                        android:textColor="@color/black" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray" />

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:focusable="true"
                        android:text="@string/product_three"
                        android:textColor="@color/darkgray" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinner_Product_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:drawableRight="@drawable/downarrow"
                        android:text="Select Product Three"
                        android:textColor="@color/black" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_remaining_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="right"
                    android:visibility="gone"
                    android:orientation="horizontal">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/remaing_days_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/darkgray" />

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/num_days_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:focusable="true"
                        android:maxLength="4"
                        android:text=""
                        android:textColor="@color/red" />
                </LinearLayout>

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="State"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select State"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="District"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select District"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="Territory"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_territory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Territory"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="Tehsil"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinner_tehsil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Tehsil"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Village"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/etRetVillage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Select Village"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray" />
                <!-- <com.dhanuka.indhan.Fonts.Medium
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:layout_marginTop="@dimen/_20sdp"
                       android:focusable="true"
                       android:text="Farmer's Expected"
                       android:textColor="@color/darkgray" />-->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilfarmer"
                    style="@style/TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">

                    <com.dhanuka.indhan.Fonts.RegularEditText
                        android:id="@+id/etRetfarmer"
                        android:visibility="gone"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:backgroundTint="@color/darkgray"
                        android:drawablePadding="@dimen/_5sdp"
                        android:focusableInTouchMode="true"
                        android:hint="Enter Farmer's Expected"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1"
                        android:paddingBottom="@dimen/_10sdp"
                        android:paddingRight="@dimen/_5sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/darkgray"
                        android:textSize="@dimen/_14sdp" />
                </com.google.android.material.textfield.TextInputLayout>


                <!--<com.dhanuka.indhan.Fonts.Medium
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="@dimen/_20sdp"
                      android:focusable="true"
                      android:text="PDA Expected"
                      android:textColor="@color/darkgray" />
      -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVillage"
                    style="@style/TextInputLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp">

                    <com.dhanuka.indhan.Fonts.RegularEditText
                        android:id="@+id/etRetpda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:backgroundTint="@color/darkgray"
                        android:drawablePadding="@dimen/_5sdp"
                        android:focusableInTouchMode="true"
                        android:hint="Acerage"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1"
                        android:paddingBottom="@dimen/_10sdp"
                        android:paddingRight="@dimen/_5sdp"
                        android:paddingTop="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/darkgray"
                        android:textSize="@dimen/_14sdp" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:layout_width="match_parent"
                android:gravity="center"
                android:textSize="@dimen/_14sp"
                android:id="@+id/txtQuestionAssign"
                android:textColor="@color/colorButton"
                android:text="Whom are you creating this ATP for"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/rgATP"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/rdMySelf"
                    android:layout_width="wrap_content"
                    android:text="My Self"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_10dp" />
                <RadioButton
                    android:id="@+id/rdCP"
                    android:text="Counter Partner"
                    android:layout_marginStart="@dimen/_10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10dp" />

            </RadioGroup>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/tvReAddNewActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:paddingRight="@dimen/_16sdp"
                android:text="Save &amp; Add new activity"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListPlanAtpList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@color/bg_gray"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/submit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="Submit"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />
    </com.google.android.material.appbar.AppBarLayout>
</LinearLayout>