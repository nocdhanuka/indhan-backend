<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/_10sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/title_demo_request"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_8sdp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:padding="@dimen/_6sdp"
                android:singleLine="true"
                android:text="@string/demo_requests"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_16sdp" />
            <ImageView
                android:id="@+id/imgFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/filter"
                android:tint="@color/white"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/_10dp"
                android:layout_alignParentRight="true" />

            <ImageView
                android:id="@+id/btnOfflineDemoRequests"
                android:layout_width="@dimen/_35dp"
                android:layout_height="@dimen/_35dp"
                android:layout_centerInParent="true"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_toLeftOf="@+id/imgFilter"
                android:background="@drawable/offlineupload"
                android:padding="@dimen/_10sdp" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDemoRequest"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </androidx.recyclerview.widget.RecyclerView>
        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/txtNoDataFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No data found!"
            android:visibility="gone"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/llCreateDemoRequest"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:gravity="center"
        android:background="@color/colorPrimary">

        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_8sdp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/create_new_demo_request"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_16sdp" />


    </LinearLayout>


</LinearLayout>