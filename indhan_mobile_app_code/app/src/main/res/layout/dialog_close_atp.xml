<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_30sdp"
    android:layout_marginEnd="@dimen/_30sdp"

    android:background="@color/White"
    android:gravity="center"
    android:orientation="vertical">



    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_margin="@dimen/_30sdp"
        android:layout_height="wrap_content">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="center"
            android:text="@string/please_share_the_reason_for_not_attending_the_activity"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <com.dhanuka.indhan.Fonts.RegularEditText
            android:id="@+id/edtTextField"
            android:layout_width="match_parent"
            android:background="@drawable/bg_edit"
            android:layout_height="wrap_content"
            android:layout_below="@+id/msg"
            android:layout_gravity="center"
            android:padding="@dimen/_5sdp"
            android:layout_margin="@dimen/_10sdp"
            android:gravity="center"
            android:hint="Reason"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"

        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/darkgray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/tvMeOkay"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:text="Close ATP"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_16sp" />


        <View
            android:layout_width="@dimen/_1dp"
            android:layout_height="match_parent"
            android:background="@color/darkgray" />

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/tvMeCancel"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            android:text="Cancel"
            android:textColor="@color/red"
            android:textSize="@dimen/_16sp" />

    </LinearLayout>



</LinearLayout>