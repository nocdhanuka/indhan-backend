<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:paddingEnd="@dimen/_4sdp"
            android:paddingRight="@dimen/_4sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_action_back"
                android:contentDescription="@string/add_image"
                android:padding="@dimen/_10sdp" />
        </LinearLayout>

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/ivBack"
            android:text="Institutional - Add New Distributor"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/llType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtMarket">

                <com.dhanuka.indhan.Fonts.Regular
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.3"
                    android:text="It is a ?"
                    android:textSize="@dimen/_14sp" />

                <RadioGroup
                    android:id="@+id/rgbForWhat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.7"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <RadioButton
                        android:id="@+id/rbDistributor"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Distributor"
                        android:textSize="@dimen/_14sp" />

                    <RadioButton
                        android:id="@+id/rbAdvisor"
                        android:layout_width="@dimen/_0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Advisor"
                        android:textSize="@dimen/_14sp" />

                </RadioGroup>


            </LinearLayout>


            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:text="FL- Santosh Kumar"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtSubmitDistributor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_40sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginRight="@dimen/_40sdp"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:paddingLeft="@dimen/_8sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingRight="@dimen/_8sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:text="Save"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="@+id/txtCropsWorking"
                app:layout_constraintStart_toStartOf="@+id/txtCropsWorking"
                app:layout_constraintTop_toBottomOf="@+id/txtCropsWorking" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtDistrict"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select District"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtName" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtTerritory"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Territory"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtDistrict" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtMarket"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Market"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtTerritory" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtAddProperitor"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="* Provide Distributor firm or Proprietor name"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:inputType="text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llType" />


            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtADistributorName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="* Distributor name"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtAddProperitor" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtMobileFirst"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="* WhatsApp number"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:inputType="phone"
                android:maxLength="10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtADistributorName" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtMobileSecond"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Mobile Number 2"
                android:padding="@dimen/_5sdp"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtMobileFirst" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtAddress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="*Address"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:inputType="textPostalAddress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtMobileSecond" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtPincode"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="*Pin code"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                android:inputType="number"
                android:maxLength="6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtAddress" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtTurnOver"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="*Provide total party turnover in INR"
                android:padding="@dimen/_5sdp"
                android:inputType="numberDecimal"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtPincode" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtBrandWorking"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:drawableRight="@drawable/downarrow"
                android:hint="*Provide brand working with (comma seperated)"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtTurnOver" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtCropsWorking"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="*Provide Crops working with (select multiple)"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtBrandWorking" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>