<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_gray"
    android:minHeight="@dimen/_100sdp"
    android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:elevation="@dimen/_15sdp"
        android:minHeight="@dimen/_90sdp"
        android:paddingTop="@dimen/_10sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/_10sdp">


            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/bdo_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_15sdp"
                android:focusable="true"
                android:text="BDO :"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/bdo_name"
                android:layout_marginLeft="@dimen/_15sdp"
                android:text="4:20 am"
                android:textColor="@color/darkgray" />


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/prod_type_tv"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/time_tv"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="testing"
                android:textColor="@color/darkgray" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/remark_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/prod_type_tv"
                android:layout_marginLeft="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="testing.."
                android:lines="4"
                android:maxLines="4"
                android:singleLine="true"
                android:textColor="@color/darkgray" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>