<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android = "http://schemas.android.com/apk/res/android"
    xmlns:tools = "http://schemas.android.com/tools"
    android:layout_width = "match_parent"
    android:layout_height = "match_parent"
    android:background = "@color/White"
    android:orientation = "vertical"
    android:weightSum = "12" >

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width = "match_parent"
        android:layout_height = "0dp"
        android:layout_weight = "1" >

        <RelativeLayout
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:background = "@color/colorPrimary"
            android:elevation = "@dimen/_10sdp" >

            <LinearLayout
                android:id = "@+id/iCross"
                android:layout_width = "@dimen/_50sdp"
                android:layout_height = "match_parent"
                android:layout_alignParentLeft = "true"
                android:layout_centerInParent = "true"
                android:gravity = "center"
                tools:ignore = "DuplicateIds" >

                <ImageView
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:background = "@drawable/ic_arrow_back"
                    android:padding = "@dimen/_10sdp" />

            </LinearLayout >


            <com.dhanuka.indhan.Fonts.Regular
                android:id = "@+id/date"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:layout_centerVertical = "true"
                android:layout_marginLeft = "@dimen/_10sdp"
                android:layout_toRightOf = "@+id/iCross"
                android:textColor = "@android:color/white"
                android:textSize = "@dimen/_15sdp" />

        </RelativeLayout >

    </com.google.android.material.appbar.AppBarLayout >

    <LinearLayout
        android:layout_width = "match_parent"
        android:layout_height = "0dp"
        android:layout_weight = "10"
        android:orientation = "vertical" >

        <ScrollView
            android:layout_width = "match_parent"
            android:layout_height = "match_parent" >

            <LinearLayout
                android:id = "@+id/layout"
                android:layout_width = "match_parent"
                android:layout_height = "0dp"
                android:layout_weight = "10"
                android:orientation = "vertical"
                android:padding = "@dimen/_10sdp" >

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Product"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_product"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select Month"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Crop"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_crop"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select Month"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Type of Meeting"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_ds"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "- -"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />
                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Language"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_language"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "- -"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "State"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_state"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select State"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "District"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_district"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select district"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Tehsil"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_tehsil"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select teshil"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Village"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_village"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Village"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "Farmers Expected"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_farmer"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select Month"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_10sdp"
                    android:focusable = "true"
                    android:text = "PDA Expected"
                    android:textColor = "@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id = "@+id/tv_pda"
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "@dimen/_5sdp"
                    android:text = "Select Month"
                    android:textColor = "@color/black" />

                <View
                    android:layout_width = "match_parent"
                    android:layout_height = "@dimen/_1sdp"
                    android:layout_marginRight = "@dimen/_14sdp"
                    android:background = "@color/darkgray" />
            </LinearLayout >
        </ScrollView >
    </LinearLayout >

    <com.google.android.material.appbar.AppBarLayout
        android:id = "@+id/appBarBottom"
        android:layout_width = "match_parent"
        android:layout_height = "0dp"
        android:layout_weight = "1" >

        <com.dhanuka.indhan.Fonts.Regular
            android:id = "@+id/activateTicketBtn"
            android:layout_width = "match_parent"
            android:layout_height = "match_parent"
            android:layout_centerVertical = "true"

            android:gravity = "center"
            android:text = "Activate Ticket"
            android:textColor = "@android:color/white"
            android:textSize = "@dimen/_15sdp" />
    </com.google.android.material.appbar.AppBarLayout >
</LinearLayout >