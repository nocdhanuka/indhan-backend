<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/pd_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_20sdp"
            android:text="Edit details"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />


    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@color/white">

            <RelativeLayout
                android:id="@+id/rlPicture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtDateName">

                <ImageView
                    android:id="@+id/imgPicture"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@color/bg_gray"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/imgCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/camera_white" />

                <ImageView
                    android:id="@+id/imgCross"
                    android:layout_width="@dimen/_30dp"
                    android:layout_height="@dimen/_30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:background="@drawable/bg_circle"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/cross"
                    android:visibility="gone" />
            </RelativeLayout>

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtContactNo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/txtFullName"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtProductName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/edtAltContactsNO"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:padding="@dimen/_5sdp"
                android:text="Standing Product Name"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp"
                android:visibility="gone" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtDateName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/txtProductName"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:padding="@dimen/_5sdp"
                android:text="Expected date for purchase"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp"
                android:visibility="gone" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtFullName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />


            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_below="@+id/rlPicture"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@color/colorButton"
                android:text="@string/submit"
                android:textColor="@color/white" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtAltContactsNO"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/txtContactNo"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Alternate Mobile No."
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />


        </RelativeLayout>

    </ScrollView>
</LinearLayout>