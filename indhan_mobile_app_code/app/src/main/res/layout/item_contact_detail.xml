<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:padding="@dimen/_2dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        card_view:cardBackgroundColor="#f0f2f5"
        card_view:cardCornerRadius="@dimen/_10sdp"
        card_view:cardElevation="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtSelectDesignation"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtSelectLevel"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/input_border"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Designation"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtSelectLevel"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_border"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Level"
                android:maxLength="50"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/etWaNumber"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etPersonName"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/input_border"
                android:digits="1234567890"
                android:hint="Whatsapp Number"
                android:inputType="phone"
                android:maxLength="10"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/etMobileNumber"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etWaNumber"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/input_border"
                android:hint="@string/mobile_number"
                android:inputType="phone"
                android:digits="1234567890"
                android:maxLength="10"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/etEmail"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/etMobileNumber"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/input_border"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:maxLength="100"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/etPersonName"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtSelectDesignation"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/input_border"
                android:hint="Person Name"
                android:inputType="textPersonName"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:maxLength="60"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>