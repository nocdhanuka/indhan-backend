<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:id="@+id/llayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:background="@color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgFarmer"
            android:background="@drawable/def_user"
            android:layout_width="@dimen/_70sdp"
            android:scaleType="center"
            android:layout_margin="@dimen/_5dp"
            android:layout_height="@dimen/_70sdp" />

        <TextView
            android:id="@+id/txtVillageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="Village name"
            android:textColor="@color/colorButton"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/txtNoOfFarmers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtVillageName"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="No of farmers"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:id="@+id/txtAvgVisit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtNoOfFarmers"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="41 visit/month/farmer"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />
    </RelativeLayout>
</layout>