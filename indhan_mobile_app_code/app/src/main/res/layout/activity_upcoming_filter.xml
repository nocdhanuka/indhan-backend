<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/bg_gray"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:elevation="@dimen/_10sdp">

            <LinearLayout
                android:id="@+id/iCross"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                tools:ignore="DuplicateIds">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_arrow_back"
                    android:padding="@dimen/_10sdp" />

            </LinearLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/pd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_toRightOf="@+id/iCross"
                android:text="@string/filter_upcoming_atp"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15sdp" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/_20sdp"
                android:text="Reset"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13sdp"
                android:visibility="gone" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginRight="@dimen/_15sdp"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="@dimen/_30dp"
            android:layout_marginRight="20dp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/llRSM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtRSM"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select RSM"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llASM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtASM"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select ASM"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:layout_marginBottom="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtFL"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select FL"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">



                <LinearLayout
                    android:id="@+id/llOriginalDd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:background="@drawable/input_border"
                    android:orientation="horizontal">

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/txtDdName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_15dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:hint="@string/select_dd"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_18dp"
                        android:src="@drawable/downarrow" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llDdWithRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_border"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.dhanuka.indhan.Fonts.Regular
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/_15dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:hint="@string/select_dd"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_18dp"
                            android:src="@drawable/downarrow" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDdName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5dp"/>

                </LinearLayout>



            </FrameLayout>



            <LinearLayout
                android:id="@+id/llSelectDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtSelectDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="@string/select_date"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginLeft="@dimen/_20dp"
            android:layout_marginRight="@dimen/_20dp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:orientation="horizontal">

            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_marginRight="@dimen/_5dp"
                android:layout_weight="1"
                android:background="@drawable/filter_rectangle_stroke"
                android:elevation="15dp"
                android:text="@string/clear"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_13sdp" />

            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_5dp"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_weight="1"
                android:background="@drawable/filter_rectangle_solid"
                android:elevation="15dp"
                android:text="@string/apply"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />

        </LinearLayout>
    </RelativeLayout>

</LinearLayout>