<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:id="@+id/llayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:background="@color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/edit"
            android:padding="@dimen/_10dp"
            android:tint="@color/colorButton"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/_20dp"
            android:layout_alignParentRight="true" />

        <ImageView
            android:id="@+id/imgFarmer"
            android:background="@drawable/def_user"
            android:layout_width="@dimen/_70sdp"
            android:scaleType="center"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="@dimen/_20dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_height="@dimen/_65sdp"
            android:layout_marginLeft="@dimen/_20dp" />

        <TextView
            android:id="@+id/txtFarmerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="Village name"
            android:layout_marginTop="@dimen/_20dp"
            android:textColor="@color/colorButton"
            android:textSize="@dimen/_15sdp" />

        <TextView
            android:id="@+id/txtNoOfVillage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtFarmerName"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="No of farmers"
            android:textColor="@color/black"
            android:textSize="@dimen/_14sp" />

        <TextView
            android:id="@+id/txtNoOfCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtNoOfVillage"
            android:layout_toEndOf="@+id/imgFarmer"
            android:layout_toRightOf="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="41 visit/month/farmer"
            android:textColor="@color/black"
            android:textSize="@dimen/_14sp" />

        <TextView
            android:id="@+id/txtAvg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="@dimen/_5dp"
            android:text="Average visit per Village"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sp"
            android:layout_marginLeft="@dimen/_20dp" />
        <TextView
            android:id="@+id/txtAvgNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgFarmer"
            android:padding="@dimen/_2sdp"
            android:text="12"
            android:layout_toEndOf="@+id/txtAvg"
            android:layout_marginStart="@dimen/_2dp"
            android:layout_marginTop="@dimen/_5dp"
            android:textColor="@color/colorButton"
            android:textSize="@dimen/_12sp"
            android:layout_marginLeft="@dimen/_20dp"
            android:layout_toRightOf="@+id/txtAvg" />
    </RelativeLayout>
</layout>