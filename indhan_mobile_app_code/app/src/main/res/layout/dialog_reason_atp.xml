<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20dp"
        android:layout_marginRight="@dimen/_20dp"
        android:background="@drawable/round_corner_white"
        android:orientation="vertical">

        <com.dhanuka.indhan.Fonts.Medium
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_40dp"
            android:gravity="center"
            android:text="@string/close_activate"
            android:textColor="@color/black"
            android:textSize="@dimen/_16sp" />

        <com.dhanuka.indhan.Fonts.Medium
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_20dp"
            android:gravity="center"
            android:text="@string/new_activate"
            android:textColor="@color/black"
            android:textSize="@dimen/_16sp" />

        <LinearLayout
            android:id="@+id/llPurchasedArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_30dp"
            android:layout_marginTop="@dimen/_30dp"
            android:layout_marginRight="@dimen/_30dp"
            android:background="@drawable/input_border"
            android:gravity="center"
            android:orientation="horizontal">

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:hint="@string/enter_reasons"
                android:padding="@dimen/_10dp"
                android:textColorHint="@color/black" />


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1dp"
            android:layout_marginTop="@dimen/_50dp"
            android:background="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtCloseAtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_15dp"
                android:text="@string/close_atp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_14sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/colorPrimary" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtCloseCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/_15dp"
                android:text="@string/cancel"
                android:textColor="@color/red"
                android:textSize="@dimen/_14sp" />


        </LinearLayout>

    </LinearLayout>
</LinearLayout>