<?xml version="1.0" encoding="utf-8"?>
<LinearLayout   xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="12"
    android:background="@color/White"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:elevation="@dimen/_10sdp">

            <LinearLayout
                android:id="@+id/iCross"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                tools:ignore="DuplicateIds">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_arrow_back"
                    android:padding="@dimen/_10sdp"
                    />

            </LinearLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_toRightOf="@+id/iCross"
                android:text="@string/syllabus_history"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15sdp" />

            <!--<LinearLayout
                android:id="@+id/exportdb_btn"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_50sdp"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:gravity="center">
                <ImageView
                    android:adjustViewBounds="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tick_white"
                    android:padding="@dimen/_10sdp" />
            </LinearLayout>-->


        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_weight="1">
        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/spinnersyllabusMonth"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_14sdp"
            android:layout_marginLeft="@dimen/_14sdp"
            android:drawableRight="@drawable/downarrow"
            android:text="Select Month"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/filterByBDOBtn"
            android:layout_marginLeft="@dimen/_30sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_width="@dimen/_30sdp"
            android:src="@drawable/bdo_wise_grey"
            android:text="prod"
            android:layout_height="match_parent" />
        <ImageView
            android:id="@+id/filterByProductBtn"
            android:layout_marginRight="@dimen/_30sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_width="@dimen/_30sdp"
            android:src="@drawable/product_wise_grey"
            android:text="prod"
            android:layout_height="match_parent" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/rcViewSyllabusHistory"
        android:visibility="visible"
        android:layout_weight="9"
        />
    <com.dhanuka.indhan.Fonts.Regular
        android:layout_width="match_parent"
        android:visibility="gone"
        android:id="@+id/nodata"
        android:text="No Syllabus History"
        android:gravity="center"
        android:textSize="@dimen/_25sdp"
        android:textColor="@color/darkgray"
        android:layout_height="0dp"
        android:layout_weight="9"
        />
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="match_parent"
            android:gravity="center"
            android:id="@+id/submit_api"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/ivCross"
            android:text="Share"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />


    </com.google.android.material.appbar.AppBarLayout>
</LinearLayout>
