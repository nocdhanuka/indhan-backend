<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Reports.supervisor_report.fragments.CustomerCareFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/bg_gray"
        android:padding="@dimen/_10dp"
        android:layout_height="wrap_content">

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/txtHeader"
            android:layout_width="wrap_content"
            android:layout_centerHorizontal="true"
            android:padding="@dimen/_5dp"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_20sp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_10dp"
            android:textColor="@color/colorButton"
            android:text="Customer care Queries"/>


        <RelativeLayout
            android:id="@+id/rlOne"
            android:layout_width="match_parent"
            android:layout_below="@+id/txtHeader"
            android:background="@color/white"
            android:padding="@dimen/_10dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtOpen"
                android:layout_width="wrap_content"
                android:textSize="@dimen/_25sp"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:textColor="@color/colorButton"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_below="@+id/txtOpen"
                android:layout_width="wrap_content"
                android:text="Open"
                android:textSize="@dimen/_14sp"
                android:layout_centerHorizontal="true"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlTwo"
            android:layout_width="match_parent"
            android:layout_below="@+id/rlOne"
            android:background="@color/white"
            android:padding="@dimen/_10dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtClosed"
                android:layout_width="wrap_content"
                android:textSize="@dimen/_25sp"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:textColor="@color/colorButton"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="wrap_content"
                android:text="Closed"
                android:layout_below="@+id/txtClosed"
                android:textSize="@dimen/_14sp"
                android:layout_centerHorizontal="true"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlThree"
            android:layout_width="match_parent"
            android:layout_below="@+id/rlTwo"
            android:background="@color/white"
            android:padding="@dimen/_10dp"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtFollow"
                android:layout_width="wrap_content"
                android:textSize="@dimen/_25sp"
                android:layout_centerHorizontal="true"
                android:textStyle="bold"
                android:textColor="@color/colorButton"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_below="@+id/txtFollow"
                android:layout_width="wrap_content"
                android:text="Follow"
                android:textSize="@dimen/_14sp"
                android:layout_centerHorizontal="true"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>



        </RelativeLayout>



    </RelativeLayout>



</FrameLayout>