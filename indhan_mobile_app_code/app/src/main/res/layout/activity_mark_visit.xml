<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/colorButton"
        android:layout_height="@dimen/_40sdp">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/pd_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark Visit"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_20sdp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />

        <ImageView
            android:id="@+id/ivOfflineData"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:padding="@dimen/_5sdp"
            app:srcCompat="@drawable/ic_baseline_cloud_off"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:paddingBottom="@dimen/_10dp"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_15sdp"
            >

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtVillageName"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:layout_width="match_parent"
                android:background="@drawable/bg_edit"
                android:textSize="@dimen/_12sdp"
                android:padding="@dimen/_5sdp"
                android:text="Select Village Name"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_margin="@dimen/_10sdp"
                android:layout_height="@dimen/_30sdp" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtFarmersName"
                android:layout_width="match_parent"
                android:background="@drawable/bg_edit"
                android:textSize="@dimen/_12sdp"
                android:padding="@dimen/_5sdp"
                android:text="Select Farmers Name"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:layout_below="@+id/txtVillageName"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_margin="@dimen/_8sdp"
                android:layout_height="@dimen/_30sdp" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtCropName"
                android:layout_width="match_parent"
                android:background="@drawable/bg_edit"
                android:textSize="@dimen/_12sdp"
                android:padding="@dimen/_5sdp"
                android:text="Standing Crop Name"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:layout_below="@+id/txtFarmersName"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_margin="@dimen/_10sdp"
                android:layout_height="@dimen/_30sdp" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtProductName"
                android:layout_width="match_parent"
                android:background="@drawable/bg_edit"
                android:textSize="@dimen/_12sdp"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"
                android:text="Standing Product Name"
                android:layout_below="@+id/txtCropName"
                android:textColor="@color/black"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:textColorHint="@color/black"
                android:layout_margin="@dimen/_10sdp"
                android:layout_height="@dimen/_30sdp" />

            <com.dhanuka.indhan.Fonts.BoldTextView
                android:id="@+id/txtDateName"
                android:layout_width="match_parent"
                android:background="@drawable/bg_edit"
                android:textSize="@dimen/_12sdp"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"
                android:text="Expected date for purchase"
                android:layout_below="@+id/txtProductName"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_margin="@dimen/_10sdp"
                android:layout_height="@dimen/_30sdp" />



            <RelativeLayout
                android:id="@+id/rlPicture"
                android:layout_width="match_parent"
                android:layout_below="@id/txtDateName"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgPicture"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@color/bg_gray"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/imgCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/camera_white"
                    android:layout_centerInParent="true"
                    />
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imgCross"
                    android:layout_width="@dimen/_30dp"
                    android:layout_height="@dimen/_30dp"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/cross"
                    android:background="@drawable/bg_circle"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true" />
            </RelativeLayout>


            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_below="@+id/rlPicture"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@color/colorButton"
                android:text="Next"
                android:textColor="@color/white" />


        </RelativeLayout>

    </ScrollView>
</LinearLayout>