<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/tvDistrictName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="start"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        style="?android:listSeparatorTextViewStyle"
        android:textStyle="normal"
        android:textAllCaps="false"
        android:maxLines="2"
        android:minLines="1"
        android:padding="@dimen/_5sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvUserFY"/>

    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/tvUserFY"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        style="?android:listSeparatorTextViewStyle"
        android:textStyle="normal"
        android:textAllCaps="false"
        android:maxLines="2"
        android:minLines="1"
        android:padding="@dimen/_5sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtChemicalCropSelectedClass"/>

    <LinearLayout
        android:id="@+id/llVolumeFormulation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@+id/tvDistrictName"
        app:layout_constraintStart_toStartOf="@+id/tvDistrictName"
        app:layout_constraintTop_toBottomOf="@+id/tvDistrictName">

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/tvFormulationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="start"
            style="?android:listSeparatorTextViewStyle"
            android:textStyle="normal"
            android:textAllCaps="false"
            android:maxLines="2"
            android:minLines="1"
            android:padding="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp" />

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/tvFormulationVolume"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.5"
            android:gravity="center"
            android:visibility="gone"
            android:padding="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp" />


        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/tvFormulationTotal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_25sdp"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.5"
            android:visibility="gone"
            android:gravity="center"
            android:padding="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/llHeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/_20sdp"
            android:text="Molecules Data Collection - Add Crop Wise"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_14sdp" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvCropItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTotalValuePercentage"
        app:layout_constraintEnd_toEndOf="@+id/llVolumeFormulation"
        app:layout_constraintStart_toStartOf="@+id/llVolumeFormulation"
        app:layout_constraintTop_toBottomOf="@+id/llVolumeFormulation" />

    <com.dhanuka.indhan.Fonts.BoldTextView
        android:id="@+id/txtChemicalCropSelectedClass"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:drawablePadding="@dimen/_5dp"
        android:hint="Selected Class - "
        android:padding="@dimen/_5sdp"
        android:visibility="gone"
        android:textColor="@color/black"
        android:textColorHint="@color/darkgray"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader" />

    <com.dhanuka.indhan.Fonts.Medium
        android:id="@+id/tvTotalValuePercentage"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:paddingRight="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:background="@color/red"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:text="Total %"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_14sp"
        app:layout_constraintBottom_toTopOf="@+id/txtSubmitChemicalCropWise"
        app:layout_constraintEnd_toEndOf="@+id/txtSubmitChemicalCropWise" />

    <com.dhanuka.indhan.Fonts.Medium
        android:id="@+id/txtSubmitChemicalCropWise"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_40sdp"
        android:layout_marginBottom="@dimen/_40sdp"
        android:layout_weight="1"
        android:background="@color/colorPrimary"
        android:gravity="center"
        android:paddingLeft="@dimen/_8sdp"
        android:paddingTop="@dimen/_5sdp"
        android:paddingRight="@dimen/_8sdp"
        android:paddingBottom="@dimen/_5sdp"
        android:text="Next"
        android:textColor="@color/white"
        android:textSize="@dimen/_14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
