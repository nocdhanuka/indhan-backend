<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_15dp"
        android:background="@drawable/round_corner_white"
        android:orientation="vertical">

        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:gravity="center"
            android:text="@string/please_rate_experience"
            android:textColor="@color/colorPrimary" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/rdgRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_marginTop="@dimen/_15dp">

                    <RadioButton
                        android:id="@+id/rdbExcellente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/excellent"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_14sp" />

                    <RadioButton
                        android:id="@+id/rdbAverage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/average"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_14sp" />

                    <RadioButton
                        android:id="@+id/rdbPoor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/poor"

                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_14sp" />
                </RadioGroup>

                <com.dhanuka.indhan.Fonts.RegularEditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_200dp"
                    android:layout_marginLeft="@dimen/_15dp"
                    android:layout_marginTop="@dimen/_20dp"
                    android:layout_marginRight="@dimen/_15dp"
                    android:hint="@string/description"
                    android:gravity="top"
                    android:paddingLeft="@dimen/_10dp"
                    android:paddingTop="@dimen/_5dp"
                    android:background="@drawable/bg_edit"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textSize="@dimen/_14sp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp">

                    <ImageView
                        android:id="@+id/imgUploadPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_150sdp"
                        android:layout_marginLeft="@dimen/_15sdp"
                        android:layout_marginRight="@dimen/_15sdp"
                        android:layout_marginBottom="@dimen/_10dp"
                        android:background="@color/bg_gray"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/icPhoto"
                        android:layout_width="@dimen/_50dp"
                        android:layout_height="@dimen/_50dp"
                        android:layout_centerInParent="true"
                        app:srcCompat="@drawable/camera_white" />
                </RelativeLayout>


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/txtUploadPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Upload photo"
                    android:textColor="@color/black" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/txtSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_20dp"
                        android:layout_marginTop="@dimen/_40dp"
                        android:layout_marginRight="@dimen/_20dp"
                        android:layout_marginBottom="@dimen/_20dp"
                        android:layout_weight="1"
                        android:background="@color/colorPrimary"
                        android:gravity="center"
                        android:padding="@dimen/_15dp"
                        android:text="@string/submit"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sp" />


                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>