<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    android:orientation="vertical"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/colorButton"
        android:layout_height="@dimen/_40sdp">

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/pd_name"
            android:layout_centerHorizontal="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Village Details"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_20sdp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />






    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:background="@color/colorButton"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/txtNoFarmer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_20sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"

                    />

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/txtFarmers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Farmers"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_below="@+id/txtNoFarmer"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_12sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"

                    />

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/txtNoOfAvgVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_20sdp"
                    android:layout_toRightOf="@+id/txtFarmers"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"

                    />

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/txtAvgVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Visit"
                    android:layout_toRightOf="@+id/txtFarmers"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:layout_below="@+id/txtNoFarmer"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_12sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"

                    />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/txtDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="District Kanpur"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:textColor="@android:color/white"
                    android:layout_below="@id/txtFarmers"
                    android:textSize="@dimen/_12sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"

                    />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/txtAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UP,India "
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_12sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:drawablePadding="@dimen/_5sdp"
                    android:layout_below="@+id/txtDistrict"

                    />




            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            </RelativeLayout>




        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_40sdp"
                    android:background="@color/transparent"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <com.dhanuka.indhan.Fonts.BoldTextView
                                android:id="@+id/txtNoCrop"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="@dimen/_20sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:drawablePadding="@dimen/_5sdp"
                                android:text="45"
                                android:textColor="@color/colorButton"
                                android:textSize="@dimen/_25sdp"

                                />

                            <com.dhanuka.indhan.Fonts.Regular
                                android:id="@+id/txtCrop1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txtNoCrop"
                                android:layout_centerHorizontal="true"
                                android:layout_marginLeft="@dimen/_20sdp"
                                android:layout_marginRight="@dimen/_20sdp"
                                android:layout_marginBottom="@dimen/_5sdp"
                                android:text="Crops"
                                android:textColor="@color/colorButton"
                                android:textSize="@dimen/_12sdp" />
                            <LinearLayout
                                android:id="@+id/llayout"
                                android:layout_below="@id/txtCrop1"
                                android:layout_width="match_parent"
                                android:background="@color/white"
                                android:layout_height="wrap_content">





                                <TextView
                                    android:id="@+id/txtCrop"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:textColor="@color/colorButton"
                                    android:textSize="@dimen/_12sdp"
                                    android:padding="@dimen/_5sdp"
                                    android:text="Crop Name"
                                    />
                                <TextView
                                    android:id="@+id/txtNoOfAcres"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/colorButton"
                                    android:layout_gravity="center"
                                    android:textSize="@dimen/_12sdp"
                                    android:padding="@dimen/_5sdp"
                                    android:text="Acres"
                                    />

                                <TextView
                                    android:id="@+id/txtFarmers1"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/colorButton"
                                    android:textSize="@dimen/_12sdp"
                                    android:padding="@dimen/_5sdp"
                                    android:text="Farmers"
                                    />
                            </LinearLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/llayout"/>

                        </RelativeLayout>
                    </androidx.core.widget.NestedScrollView>

                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <com.dhanuka.indhan.Fonts.RegularButton
            android:id="@+id/btnViewAll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:text="View Farmers"
            android:textColor="@color/white"
            android:layout_alignParentBottom="true"
            android:background="@color/colorButton"
            />

    </RelativeLayout>






</LinearLayout>