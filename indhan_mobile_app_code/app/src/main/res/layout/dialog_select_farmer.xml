<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:background="@color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:orientation="vertical">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/txtSelectExistingFarmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40dp"
            android:gravity="center"
            android:text="@string/select_from_existing_farmer"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_20dp"
            android:layout_marginLeft="@dimen/_110dp"
            android:layout_marginRight="@dimen/_110dp"
            android:background="@color/white" />
        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/txtCreateNewRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/create_new"
            android:layout_marginTop="@dimen/_15dp"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_20dp"
            android:background="@color/white"
            />

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/txtCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textSize="@dimen/_18sp"
            android:textColor="@color/white"
            android:padding="@dimen/_5dp"
            android:layout_marginBottom="@dimen/_15dp"
            android:gravity="center"
            android:layout_marginTop="@dimen/_10dp"/>
    </LinearLayout>

</LinearLayout>