<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginTop="@dimen/_10sdp"
    android:background="@color/White">

    <LinearLayout
        android:id="@+id/top_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_10sdp"
            android:minHeight="140dp"
            card_view:cardBackgroundColor="#f0f2f5"
            card_view:cardCornerRadius="@dimen/_4sdp"
            card_view:cardElevation="6sp"
            card_view:cardUseCompatPadding="true">

            <RelativeLayout
                android:id="@+id/rlBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/White"
                android:elevation="@dimen/_10sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:orientation="vertical">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvMeTicketNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_18sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.dhanuka.indhan.Fonts.Medium
                            android:id="@+id/tvMeDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|center_horizontal"
                            android:singleLine="true"
                            android:layout_marginEnd="@dimen/_50dp"
                            android:textColor="#FF7C7474"
                            android:layout_marginRight="@dimen/_50dp" />

                        <ImageView
                            android:id="@+id/ivArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerInParent="true"
                            android:layout_marginRight="@dimen/_20sdp"
                            android:background="@drawable/rightarrow_grey" />

                    </RelativeLayout>


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvMeDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:singleLine="true"
                        android:textColor="#FF837B7B" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_6sdp">

                        <com.dhanuka.indhan.Fonts.BoldTextView
                            android:id="@+id/total_farmer"
                            android:padding="@dimen/_2sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:background="@drawable/bg_text"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/colorPrimaryDark" />

                        <com.dhanuka.indhan.Fonts.BoldTextView
                            android:padding="@dimen/_2sdp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:id="@+id/total_valid_farmers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textSize="@dimen/_12sdp"
                            android:textColor="@color/colorPrimaryDark" />
                    </LinearLayout>

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/txtHighLight"
                        android:layout_width="wrap_content"
                        android:text="HIGHLIGHT"
                        android:padding="@dimen/_5dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButton"
                        android:textSize="@dimen/_14sp"
                        android:layout_height="wrap_content"/>

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/txtActivityDuration"
                        android:layout_width="wrap_content"
                        android:text="ACTIVITY DURATION"
                        android:padding="@dimen/_5dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorButton"
                        android:textSize="@dimen/_14sp"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </RelativeLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginRight="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:background="@drawable/active"
        android:visibility="visible" />

</RelativeLayout>
