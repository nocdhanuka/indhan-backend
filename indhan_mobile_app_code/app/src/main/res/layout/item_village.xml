<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp"
    android:layout_height="wrap_content">

    <com.dhanuka.indhan.Fonts.BoldTextView
        android:id="@+id/txtVillageName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Village"
        android:layout_margin="@dimen/_5sdp"
        android:textColor="@color/colorButton"
        android:textSize="@dimen/_15sdp" />
    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/txtNoOfFarmers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No of Farmers"
        android:layout_margin="@dimen/_5sdp"
        android:textColor="@color/cardview_dark_background"
        android:textSize="@dimen/_12sdp" />
    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/txtNoOfVisit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="41 Visit/village/farmer"
        android:layout_margin="@dimen/_5sdp"
        android:textColor="@color/cardview_dark_background"
        android:textSize="@dimen/_12sdp" />


</LinearLayout>