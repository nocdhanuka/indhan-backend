<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <RelativeLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:paddingRight="@dimen/_4sdp"
            android:gravity="center"
            android:paddingEnd="@dimen/_4sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_action_back"
                android:contentDescription="@string/add_image"
                android:padding="@dimen/_10sdp" />
        </LinearLayout>

        <com.dhanuka.indhan.Fonts.BoldTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/ivBack"
            android:text="Add Circulars"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llHeader"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_gray">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvAddTestimonials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtAddProperitor"
                android:nestedScrollingEnabled="false"
                android:scrollbars="none"
                tools:targetApi="lollipop" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtAddMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@color/colorPrimary"
                android:paddingLeft="@dimen/_8sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingRight="@dimen/_8sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:text="Add More"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sp"
                app:layout_constraintTop_toBottomOf="@+id/rcvAddTestimonials"
                android:layout_marginRight="@dimen/_10sdp" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtSubmitDistributor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_60sdp"
                android:layout_marginRight="@dimen/_60sdp"
                android:background="@drawable/login_button_selector"
                android:layout_marginTop="@dimen/_30sdp"
                android:elevation="15dp"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/txtAddMore"
                app:layout_constraintEnd_toEndOf="@+id/rcvAddTestimonials"
                app:layout_constraintStart_toStartOf="@+id/rcvAddTestimonials" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtPersonName"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Contacts"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSelectPublishedDate" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/spinnerInstitutionalType"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Institution Type"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerLanguage" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtState"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select State"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerInstitutionalType"  />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtDistrict"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select District"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtState" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/tvSelectPublishedDate"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Select Published Date"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtDistrict" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/txtAddProperitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:gravity="top"
                android:hint="Whats app message"
                android:minLines="4"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtPersonName" />

            <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
                android:id="@+id/etCircularName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawablePadding="@dimen/_5dp"
                android:hint="Circular Name"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                app:layout_constraintEnd_toEndOf="parent"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/spinnerLanguage"
                style="?android:listSeparatorTextViewStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:drawableEnd="@drawable/downarrow"
                android:drawableRight="@drawable/downarrow"
                android:drawablePadding="@dimen/_5dp"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_weight="1"
                android:hint="Select Language"
                android:maxLines="1"
                android:minLines="1"
                android:padding="@dimen/_5sdp"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textColorHint="@color/darkgray"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etCircularName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>