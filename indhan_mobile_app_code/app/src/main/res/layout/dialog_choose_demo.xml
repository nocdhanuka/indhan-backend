<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20dp"
            android:gravity="center"
            android:text="@string/choose_demo"
            android:textSize="@dimen/_20sdp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|left"
            android:layout_margin="@dimen/_5sdp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_search_black_36dp" />

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginLeft="5dp"
                android:hint="Type here"
                android:background="#ffffff"
                android:inputType="text" />

        </LinearLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="0.1dp"
            android:background="#d1d1d1" />




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/txtNoItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="No approved demo request yet"
                    android:gravity="center"
                    android:visibility="gone"
                    android:textSize="@dimen/_16sdp"
                    android:textColor="@color/colorPrimary"
                    />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDemoChoose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15dp" />



                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llSelectAndActive"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:background="@color/white"
            android:gravity="center">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtDemoActivate"
                android:layout_width="0dp"
                android:layout_margin="@dimen/_5dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:background="@color/colorButton"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/select_activate"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtUserActivate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_margin="@dimen/_5dp"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:background="@color/colorButton"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="User farmer and Activate"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_12sdp" />


        </LinearLayout>
    </LinearLayout>


</LinearLayout>