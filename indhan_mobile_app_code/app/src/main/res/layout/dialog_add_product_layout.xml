<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ffffff"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#a6a6a6">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="Select Crop Details"
            android:textColor="#666666"
            android:textSize="@dimen/_12sdp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_10sdp"
        android:paddingLeft="@dimen/_10sdp">


        <com.dhanuka.indhan.Fonts.Medium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:focusable="true"
            android:text="Crop"
            android:textColor="@color/darkgray" />

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/spinner_crop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:drawableRight="@drawable/downarrow"
            android:text="Select Crop"
            android:textColor="@color/black" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginRight="@dimen/_14sdp"
            android:background="@color/darkgray" />
        <com.dhanuka.indhan.Fonts.Medium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:focusable="true"
            android:text="Product"
            android:textColor="@color/darkgray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/spinnerProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:drawableRight="@drawable/downarrow"
                android:text="Select Product"
                android:textColor="@color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginRight="@dimen/_14sdp"
                android:background="@color/darkgray" />
        </LinearLayout>

        <com.dhanuka.indhan.Fonts.Medium
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:focusable="true"
            android:text="No. of Activities"
            android:textColor="@color/darkgray" />

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/spinnerDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:drawableRight="@drawable/downarrow"
            android:text="Select Activities"
            android:textColor="@color/black" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginRight="@dimen/_14sdp"
            android:background="@color/darkgray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/submit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_14sdp"
                android:background="@color/colorPrimary"
                android:paddingLeft="@dimen/_15sdp"
                android:paddingRight="@dimen/_15sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:text="Submit"
                android:textColor="@color/White" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>