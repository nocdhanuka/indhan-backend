<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton">

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/pd_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_20sdp"
            android:text="Add Farmers"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />


    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:background="@color/white">

            <LinearLayout
                android:id="@+id/llView1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/edtAltContactsNO"
                android:layout_marginLeft="@dimen/_10sdp"
                android:orientation="vertical">


                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray"
                    android:visibility="gone" />


                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinnerProduct1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:background="@drawable/bg_edit"
                    android:drawableRight="@drawable/downarrow"
                    android:padding="@dimen/_8sdp"
                    android:text="Product Name"
                    android:textColor="@color/black"
                    android:visibility="gone" />


                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/spinnerCrop1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:background="@drawable/bg_edit"
                    android:drawableRight="@drawable/downarrow"
                    android:padding="@dimen/_8sdp"
                    android:text="Crop Name"

                    android:textColor="@color/black" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/tvReAddNew1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:text="Add New Crop"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/_15sp" />

                <com.dhanuka.indhan.Fonts.RegularEditText
                    android:id="@+id/edtAcres1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:background="@drawable/bg_edit"
                    android:hint="Acres"
                    android:inputType="numberDecimal"
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llView1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray"
                        android:visibility="gone" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="Product 2"
                        android:textColor="@color/darkgray"
                        android:visibility="gone" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="Crop 2"
                        android:textColor="@color/darkgray"
                        android:visibility="gone" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinnerCrop2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:drawableRight="@drawable/downarrow"
                        android:padding="@dimen/_8sdp"
                        android:text="Crop Name"
                        android:textColor="@color/black" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinnerProduct2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:drawableRight="@drawable/downarrow"
                        android:padding="@dimen/_8sdp"
                        android:text="Product Name"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/tvReAddNew2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_16sdp"
                        android:text="Add New Crop"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp" />

                    <com.dhanuka.indhan.Fonts.RegularEditText
                        android:id="@+id/edtAcres2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:hint="Acres"
                        android:inputType="numberDecimal"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />
                </LinearLayout>

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/tvReRemove1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@color/bg_gray"
                    android:drawableRight="@drawable/delete"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:text="Product &amp; Crop 2"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llView2"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginRight="@dimen/_14sdp"
                        android:background="@color/darkgray"
                        android:visibility="gone" />

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="Product 3"
                        android:textColor="@color/darkgray"
                        android:visibility="gone" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="Crop 3"
                        android:textColor="@color/darkgray"
                        android:visibility="gone" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinnerProduct3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:drawableRight="@drawable/downarrow"
                        android:padding="@dimen/_8sdp"
                        android:text="Product Name"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <com.dhanuka.indhan.Fonts.Regular
                        android:id="@+id/spinnerCrop3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:drawableRight="@drawable/downarrow"
                        android:padding="@dimen/_8sdp"
                        android:text="Crop Name"
                        android:textColor="@color/black" />

                    <com.dhanuka.indhan.Fonts.RegularEditText
                        android:id="@+id/edtAcres3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:background="@drawable/bg_edit"
                        android:hint="Acres"
                        android:inputType="numberDecimal"
                        android:padding="@dimen/_5sdp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />
                </LinearLayout>

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/tvReRemove2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@color/bg_gray"
                    android:drawableRight="@drawable/delete"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:text="Product &amp; Crop 3"
                    android:textColor="@color/colorPrimary"
                    android:textSize="16sp" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rlImgFarmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llView3">

                <ImageView
                    android:id="@+id/imgFarmer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:layout_margin="@dimen/_10sdp"
                    android:background="@color/bg_gray" />

                <ImageView
                    android:id="@+id/imgCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/camera_white" />


                <ImageView
                    android:id="@+id/imgCross"
                    android:layout_width="@dimen/_30dp"
                    android:layout_height="@dimen/_30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:background="@drawable/bg_circle"
                    android:padding="@dimen/_5dp"
                    android:src="@drawable/cross"
                    android:visibility="gone" />
            </RelativeLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/txtClick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlImgFarmer"
                android:layout_centerHorizontal="true"
                android:padding="@dimen/_5sdp"
                android:text="Click picture with farmer" />

            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnRbSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtClick"
                android:layout_marginLeft="@dimen/_60sdp"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_marginRight="@dimen/_60sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/login_button_selector"
                android:elevation="15dp"
                android:text="@string/btn_submit"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtFullName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:hint="Full Name"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/colorButton"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtFatherName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/edtFullName"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:hint="Father Name"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/colorButton"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtContactsNo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/edtFatherName"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:hint="Contact No."
                android:inputType="number"
                android:maxLength="10"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/colorButton"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.RegularEditText
                android:id="@+id/edtAltContactsNO"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/edtContactsNo"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/bg_edit"
                android:hint="Alt Contact No."
                android:inputType="number"
                android:maxLength="10"
                android:padding="@dimen/_5sdp"
                android:textColor="@color/colorButton"
                android:textColorHint="@color/black"
                android:textSize="@dimen/_12sdp" />


        </RelativeLayout>
    </ScrollView>


</LinearLayout>