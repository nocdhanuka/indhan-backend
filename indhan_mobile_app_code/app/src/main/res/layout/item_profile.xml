<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/_10sdp"
        android:background="@color/white"
        app:cardCornerRadius="@dimen/_5dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/txtEarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="0"
                    android:textColor="@color/colorButton"
                    android:textSize="@dimen/_20sdp" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/txtMyEarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtEarning"
                    android:layout_centerHorizontal="true"
                    android:text="My Earnings"
                    android:textColor="@color/colorButton"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:id="@+id/llHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtMyEarning"
                    android:layout_marginTop="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/txtOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="Earning Date"
                        android:textColor="@color/colorButton" />

                    <TextView
                        android:id="@+id/txtThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Ticket No."
                        android:textColor="@color/colorButton" />

                    <TextView
                        android:id="@+id/txtTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Amount"
                        android:textColor="@color/colorButton" />


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/llHeading"
                    android:layout_margin="@dimen/_10sdp">

                </androidx.recyclerview.widget.RecyclerView>


                <com.dhanuka.indhan.Fonts.RegularButton
                    android:id="@+id/btnViewAll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_below="@+id/recyclerView"
                    android:background="@color/colorButton"
                    android:text="View All"
                    android:textColor="@color/white" />
            </RelativeLayout>
        </ScrollView>

    </androidx.cardview.widget.CardView>


</RelativeLayout>