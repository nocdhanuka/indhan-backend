<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <RelativeLayout
        android:id="@+id/llayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:padding="@dimen/_5sdp"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTestimonialName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_2sdp"
            android:text="Ashutosh Kumar"
            android:textColor="@color/colorButton"
            android:textSize="@dimen/_16sp" />

        <TextView
            android:id="@+id/txtTestimonialId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_2sdp"
            android:text="No.T123456"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sp"
            android:layout_alignParentRight="true" />

        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_below="@+id/txtTestimonialName"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Crop"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Product"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Created Date"
                android:textColor="@color/black"
                android:gravity="end"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lllayout"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_below="@+id/llHeader"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtCrop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Crop"
                android:textColor="@color/colorButton"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtProduct"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Product"
                android:textColor="@color/colorButton"
                android:gravity="center"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtCreatedAt"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Created Date"
                android:textColor="@color/colorButton"
                android:gravity="end"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll1Header"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_below="@+id/lllayout"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Farmer "
                android:textColor="@color/black"
                android:gravity="start"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Uploader"
                android:textColor="@color/black"
                android:gravity="end"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll2ayout"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_below="@+id/ll1Header"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/txtFarmer"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/colorButton"
                android:gravity="start"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtUploader"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/colorButton"
                android:gravity="end"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <TextView
            android:layout_below="@id/ll2ayout"
            android:id="@+id/txtDescription"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_width="match_parent"
            android:textColor="@color/black"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRating"
            android:layout_margin="@dimen/_10dp"
            android:layout_width="match_parent"
            android:layout_below="@+id/txtDescription"
            android:layout_height="wrap_content"/>

        <RelativeLayout
            android:id="@+id/rlLayout"
            android:layout_below="@+id/recyclerViewRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgTestimonial"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"
                android:layout_centerInParent="true"
                android:scaleType="centerInside"
                android:src="@drawable/video_placeholder" />

            <ImageView
                android:visibility="gone"
                android:id="@+id/imgPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/play" />

            <ProgressBar
                android:id="@+id/loader"
                android:visibility="gone"
                android:layout_margin="@dimen/_10dp"
                android:layout_centerInParent="true"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"/>



        </RelativeLayout>

        <TextView
            android:id="@+id/txtRateNow"
            android:layout_width="wrap_content"
            android:text="Rate Now"
            android:layout_below="@id/rlLayout"
            android:textColor="@color/colorButton"
            android:gravity="center"
            android:layout_height="wrap_content"/>

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            style="@style/itemRatingBar"
            android:stepSize="1.0"
            android:layout_below="@id/txtRateNow"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</layout>