<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_10sdp"
    android:layout_marginEnd="@dimen/_10sdp"
    android:layout_marginBottom="0dp"
    android:layout_marginTop="0dp"
    android:background="@color/White"
    android:gravity="center"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/_4sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp">

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/bg_edit"
                android:drawableRight="@drawable/downarrow"
                android:gravity="center"
                android:padding="@dimen/_5sdp"
                android:text="Select year"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/txtMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtYear"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/bg_edit"
                android:drawableRight="@drawable/downarrow"
                android:gravity="center"
                android:padding="@dimen/_5sdp"
                android:text="Select month"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@color/darkgray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/tvSubmitFilter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/progess_green"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Submit"
                android:textColor="@color/color_white"
                android:textSize="@dimen/_16sp" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/tvClearFilter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/blue"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="@string/clear"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sp" />

            <com.dhanuka.indhan.Fonts.Medium
                android:id="@+id/tvMeCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/red"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="Cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/_16sp" />

        </LinearLayout>

    </LinearLayout>


</androidx.cardview.widget.CardView>