<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/White"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/colorPrimary">

            <LinearLayout
                android:id="@+id/ivBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:paddingEnd="@dimen/_4sdp"
                android:paddingRight="@dimen/_4sdp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_action_back"
                    android:contentDescription="@string/add_image"
                    android:padding="@dimen/_10sdp" />
            </LinearLayout>

            <com.dhanuka.indhan.Fonts.Regular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/ivBack"
                android:layout_toRightOf="@+id/ivBack"
                android:padding="@dimen/_6sdp"
                android:text="Sugar Mill Company Details"
                android:textColor="@android:color/white"
                android:textSize="20sp" />


        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBar"
        app:layout_constraintBottom_toTopOf="@+id/llBottomLayout"
        android:layout_marginBottom="@dimen/_10sdp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/White">

            <LinearLayout
                android:id="@+id/llCompanyImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/input_border_green"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivCompanyImage"
                    android:layout_width="match_parent"
                    android:src="@drawable/app_icon"
                    android:layout_gravity="center"
                    android:layout_height="@dimen/_150sdp" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/officeType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sugar Mill - Head Office"
                    android:layout_marginTop="@dimen/_4dp"
                    android:textSize="@dimen/_9sdp"/>

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/tvManagerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Assigned To – Manager Name"
                    android:layout_marginTop="@dimen/_4dp"
                    android:textSize="@dimen/_9sdp"/>

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/tvFlName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Assigned FL – FL Name"
                    android:layout_marginTop="@dimen/_4dp"
                    android:textSize="@dimen/_9sdp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCompanyDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/input_border_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCompanyImage"
                android:orientation="vertical">

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/tvLabelAddNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sugar Mill Details"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:id="@+id/llCompany"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="Company Name"
                        android:textColor="@color/charcoalGrey" />

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvCompanyName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/colorPrimary"
                        android:text="-" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="Category"
                        android:textColor="@color/charcoalGrey" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvCategoryData"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="-"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="TurnOver"
                        android:textColor="@color/charcoalGrey" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvTurnover"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="-"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTurnOverWords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="1">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvInWords"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="In Words - "
                        android:textColor="@color/charcoalGrey" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="Land Area"
                        android:textColor="@color/charcoalGrey" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvLandArea"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="-"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Company Type"
                        android:textSize="@dimen/_12sp"
                        android:textColor="@color/charcoalGrey" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvCompanyType"
                        android:layout_width="0dp"
                        android:textSize="@dimen/_12sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-"
                        android:textColor="@color/black" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:weightSum="2">

                    <com.dhanuka.indhan.Fonts.Medium
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="Address"
                        android:textColor="@color/charcoalGrey" />


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/_12sp"
                        android:text="-"
                        android:textColor="@color/black" />

                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/relContactDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/input_border_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llCompanyDetail">


                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/tvLabelContactDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Detail"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvLabelContactDetail"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_view_contact_detail" />


            </RelativeLayout>

            <LinearLayout
                android:id="@+id/relBranchDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:padding="@dimen/_10sdp"
                android:background="@drawable/input_border_green"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relContactDetail"
                android:orientation="vertical">

                <com.dhanuka.indhan.Fonts.BoldTextView
                    android:id="@+id/tvLabelBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Branches"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_branch_view" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llBottomLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">


            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnVisitHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/login_button_selector"
                android:elevation="15dp"
                android:text="Visit History"
                android:textAllCaps="false"
                android:layout_margin="@dimen/_2sdp"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />


            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnViewTestimonial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/login_button_selector"
                android:elevation="15dp"
                android:text="View Testimonial"
                android:textAllCaps="false"
                android:layout_margin="@dimen/_2sdp"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnAddMoreContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/login_button_selector"
                android:elevation="15dp"
                android:text="Add More contact"
                android:textAllCaps="false"
                android:layout_margin="@dimen/_2sdp"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />

            <com.dhanuka.indhan.Fonts.RegularButton
                android:id="@+id/btnAddNewBranch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/login_button_selector"
                android:elevation="15dp"
                android:text="Add New Branch"
                android:layout_margin="@dimen/_2sdp"
                android:textAllCaps="false"
                android:textColor="@color/White"
                android:textSize="@dimen/_13sdp" />
        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>