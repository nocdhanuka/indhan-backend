<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_8sdp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="130dp"
        android:padding="@dimen/_8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        card_view:cardBackgroundColor="#f0f2f5"
        card_view:cardCornerRadius="@dimen/_10sdp"
        card_view:cardElevation="16dp">

        <LinearLayout
            android:id="@+id/llCompanyDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/llLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Circular Name"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/txtCircularName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/llCircularFor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Circular Institution"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvCircularFor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Circular Language"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvLanguage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDesignation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Created Date"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvCreatedDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPersonName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Publish Date"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvPublishDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWaNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/_2sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Is Published"
                    android:textColor="@color/charcoalGrey"
                    android:textSize="@dimen/_12sp" />


                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvIsPublished"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:orientation="horizontal">

                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/txtViewCircular"
                    android:layout_width="0dp"
                    android:layout_weight="0.9"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:background="@color/colorPrimary"
                    android:paddingLeft="@dimen/_4sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingRight="@dimen/_4sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="View Circular"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sp"
                    android:gravity="center_horizontal" />

                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/txtEditCircular"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:background="@color/colorPrimary"
                    android:paddingLeft="@dimen/_4sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingRight="@dimen/_4sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="Edit Circular"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sp"
                    android:gravity="center_horizontal" />

            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>