<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.dhanuka.indhan.Fonts.Regular
        android:id="@+id/tvSelectTestimonials"
        style="?android:listSeparatorTextViewStyle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_edit"
        android:drawableEnd="@drawable/downarrow"
        android:layout_marginTop="@dimen/_10sdp"
        android:drawableRight="@drawable/downarrow"
        android:drawablePadding="@dimen/_5dp"
        android:hint="Select Testimonials "
        android:maxLines="1"
        android:minLines="1"
        android:padding="@dimen/_5sdp"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textColorHint="@color/darkgray"
        android:textSize="@dimen/_12sdp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAddProperitorList" />

    <com.dhanuka.indhan.Fonts.RegularInputLayoutEditText
        android:id="@+id/txtAddProperitorList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_edit"
        android:layout_marginTop="@dimen/_15sdp"
        android:drawablePadding="@dimen/_5dp"
        android:gravity="top"
        android:hint="Write text "
        android:minLines="4"
        android:padding="@dimen/_5sdp"
        android:textColor="@color/black"
        android:textColorHint="@color/darkgray"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>