<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/_100sdp"
    android:background="@color/bg_gray">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:id="@+id/layoutname"
        android:layout_height="wrap_content">
        <View
            android:background="@color/White"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_5sdp"
            />
        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/bdo_name"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:layout_marginLeft="@dimen/_10sdp"
            android:text="testing"
            android:textColor="@color/colorPrimary" />


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"

        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp"
        android:elevation="@dimen/_25sdp"
        android:minHeight="80dp"
        card_view:cardElevation="2sp"
        card_view:cardUseCompatPadding="true">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_gravity="center"
            >

            <RelativeLayout
                android:id="@+id/productlayout"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="match_parent">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:id="@+id/pbanner"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Product"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/product_name"
                    android:layout_below="@+id/pbanner"
                    android:layout_width="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="BDO Name"
                    android:textColor="@color/black" />

                <View
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="match_parent"
                    android:background="@color/darkgray" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/croplayout"
                android:layout_toRightOf="@+id/productlayout"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="match_parent">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:id="@+id/cbanner"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Crop"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/crop_name"
                    android:layout_below="@+id/cbanner"
                    android:layout_width="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Crop Name"
                    android:textColor="@color/black" />

                <View
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="match_parent"
                    android:background="@color/darkgray" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/nodlayout"
                android:layout_toRightOf="@+id/croplayout"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:id="@+id/dbanner"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:focusable="true"
                    android:text="Activities"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/days"
                    android:layout_below="@+id/dbanner"
                    android:layout_width="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="0"
                    android:textColor="@color/black" />

                <View
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:visibility="gone"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:layout_width="@dimen/_1sdp"
                    android:layout_height="match_parent"
                    android:background="@color/darkgray" />
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/bdolayout"
                android:visibility="gone"
                android:layout_toRightOf="@+id/nodlayout"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent">

                <com.dhanuka.indhan.Fonts.Medium
                    android:layout_centerHorizontal="true"
                    android:layout_width="wrap_content"
                    android:id="@+id/bdobanner"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:focusable="true"
                    android:text="BDO"
                    android:textColor="@color/darkgray" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/bdo"
                    android:layout_below="@+id/bdobanner"
                    android:layout_width="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="0"
                    android:textColor="@color/black" />


            </RelativeLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>