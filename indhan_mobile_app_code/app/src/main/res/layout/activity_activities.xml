<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="@color/colorButton">

        <ImageView
            android:id="@+id/imgFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_margin="@dimen/_10dp"
            android:tint="@color/white"
            app:srcCompat="@drawable/filter" />

        <com.dhanuka.indhan.Fonts.Medium
            android:id="@+id/pd_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_20sdp"
            android:text="Activities"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/colorButton">


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            </RelativeLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rlSubHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:orientation="horizontal"
                android:padding="@dimen/_5dp">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/txtTotalACPFarmers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtTotalACP"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="Farmers"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sp" />

                    <TextView
                        android:id="@+id/txtTotalACP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/_25sp" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/txtTotalAcrerage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtTotalAcrerageValue"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="Villages"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sp" />

                    <TextView
                        android:id="@+id/txtTotalAcrerageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/_25sp" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_5dp"
                    android:layout_weight="1">


                    <TextView
                        android:id="@+id/txtTotalLead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtTotalLeadValue"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:text="Activities"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sp" />

                    <TextView
                        android:id="@+id/txtTotalLeadValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/_25sp" />


                </RelativeLayout>


            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewActivities"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/_20dp">

            </androidx.recyclerview.widget.RecyclerView>


        </LinearLayout>


    </RelativeLayout>


</LinearLayout>