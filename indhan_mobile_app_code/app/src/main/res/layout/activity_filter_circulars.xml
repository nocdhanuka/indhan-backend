<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary">

            <LinearLayout
                android:id="@+id/iCross"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:paddingEnd="@dimen/_4sdp"
                android:paddingRight="@dimen/_4sdp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_action_back"
                    android:contentDescription="@string/add_image"
                    android:padding="@dimen/_10sdp" />

            </LinearLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/pd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/iCross"
                android:text="Filter"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15sdp" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/reset"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="Reset"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13sdp" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/rcViewProdDes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="vertical">

        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="@dimen/_250sdp"
            android:layout_marginLeft="@dimen/_25sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="Created By"
            android:textColor="@color/black"
            android:layout_marginStart="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_20sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_120sdp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_25sdp"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_25sdp">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/fromDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Start Date"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:drawableEnd="@drawable/downarrow" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray"
                    android:layout_marginEnd="@dimen/_14sdp" />
            </LinearLayout>

            <com.dhanuka.indhan.Fonts.Regular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="To"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/_10sdp" />

            <LinearLayout
                android:layout_width="@dimen/_120sdp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/toDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="End Date"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:drawableEnd="@drawable/downarrow" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray"
                    android:layout_marginEnd="@dimen/_14sdp" />
            </LinearLayout>

        </LinearLayout>


        <com.dhanuka.indhan.Fonts.Regular
            android:layout_width="@dimen/_250sdp"
            android:layout_marginLeft="@dimen/_25sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="Published By"
            android:textColor="@color/black"
            android:layout_marginStart="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_20sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_120sdp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_25sdp"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_25sdp">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/fromDatePublished"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="Start Date"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:drawableEnd="@drawable/downarrow" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray"
                    android:layout_marginEnd="@dimen/_14sdp" />
            </LinearLayout>

            <com.dhanuka.indhan.Fonts.Regular
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="To"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/_10sdp" />

            <LinearLayout
                android:layout_width="@dimen/_120sdp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/toDatePublished"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:drawableRight="@drawable/downarrow"
                    android:text="End Date"
                    android:textColor="@color/black"
                    android:layout_marginEnd="@dimen/_14sdp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:background="@color/darkgray"
                    android:layout_marginEnd="@dimen/_14sdp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/apply"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/ivCross"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp"
            android:layout_toEndOf="@+id/ivCross" />
    </com.google.android.material.appbar.AppBarLayout>
</LinearLayout>