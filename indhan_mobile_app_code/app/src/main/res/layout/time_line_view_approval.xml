<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:layout_marginRight="10dp"
    android:orientation="horizontal">

    <com.dhanuka.indhan.util.TimelineView
        android:id="@+id/timelineApproval"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:endLineColor="@color/colorAccent"
        app:lineStyle="dash"
        app:lineStyleDashGap="2dp"
        app:lineStyleDashLength="10dp"
        app:lineWidth="3dp"
        app:markerInCenter="true"
        app:markerSize="@dimen/_16sdp"
        app:startLineColor="@color/colorAccent"  />


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="15dp"
        app:contentPadding="15dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/text_timeline_head_apr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/progess_green"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                android:text="Approval Status" />

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/text_timeline_date_apr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/llEstimatedDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.dhanuka.indhan.Fonts.Medium
                    android:id="@+id/tvEstimatedDemo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="RSM Approved Quantity"
                    android:textColor="@color/black" />


                <com.dhanuka.indhan.Fonts.RegularEditText
                    android:id="@+id/etApproveUnit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:background="@drawable/input_border"
                    android:hint="Approve Units"
                    android:inputType="number"
                    android:maxLines="1"
                    android:minLines="1"
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkgray"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llEstimatedDemo" />

            </LinearLayout>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="end"
              android:orientation="horizontal">

              <com.dhanuka.indhan.Fonts.Regular
                  android:id="@+id/btnApprove"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/_8sdp"
                  android:textAlignment="gravity"
                  android:background="@drawable/rounded_corner"
                  android:padding="@dimen/_5sdp"
                  android:layout_marginEnd="@dimen/_10dp"
                  android:text="Approve"
                  android:textColor="@color/White"
                  android:layout_marginRight="@dimen/_10dp" />

              <com.dhanuka.indhan.Fonts.Regular
                  android:id="@+id/btnReject"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/_8sdp"
                  android:textAlignment="gravity"
                  android:background="@drawable/rounded_corner_red"
                  android:padding="@dimen/_5sdp"
                  android:text="\tReject\t"
                  android:textColor="@color/White" />
          </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>