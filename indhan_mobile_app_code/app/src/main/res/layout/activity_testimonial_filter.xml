            </LinearLayout>

            <LinearLayout
                android:id="@+id/llDD"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:background="@drawable/bg_edit"
                android:orientation="vertical">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/txtDD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10dp"
                    android:drawableRight="@drawable/downarrow"
                    android:padding="@dimen/_10dp"
                    android:text="Select DD"
                    android:textColor="@color/black" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5dp">

                </androidx.recyclerview.widget.RecyclerView>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_height="wrap_content">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/fromDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edit"
                    android:drawableRight="@drawable/downarrow"
                    android:padding="@dimen/_10dp"
                    android:hint="From"
                    android:textColorHint="@color/black"
                    android:textColor="@color/black"
                    android:layout_marginRight="@dimen/_5dp" />

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/toDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5dp"
                    android:background="@drawable/bg_edit"
                    android:drawableRight="@drawable/downarrow"
                    android:padding="@dimen/_10dp"
                    android:hint="To"
                    android:textColorHint="@color/black"
                    android:textColor="@color/black"
                    android:layout_marginLeft="@dimen/_5dp" />
            </LinearLayout>

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/spinnerProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit"
                android:drawableRight="@drawable/downarrow"
                android:padding="@dimen/_10dp"
                android:textColorHint="@color/black"
                android:hint="Select Product"
                android:textColor="@color/black"
                />

            <LinearLayout
                android:id="@+id/llRSM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtRSM"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select RSM"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llASM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtASM"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select ASM"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30dp"
                android:layout_marginBottom="@dimen/_30dp"
                android:background="@drawable/input_border"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtFL"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_10dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:hint="Select FL"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_18dp"
                    android:src="@drawable/downarrow" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_20dp"
                android:orientation="horizontal"
                android:layout_height="wrap_content">

                <com.dhanuka.indhan.Fonts.RegularButton
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Clear"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:layout_marginRight="@dimen/_5dp"
                    android:background="@drawable/bg_clear_btn"
                    android:textColor="@color/colorButton"
                    />
                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="@dimen/_5dp"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Submit"
                    android:background="@color/colorButton"
                    android:textColor="@color/white"
                    />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>


</RelativeLayout>