<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginTop="@dimen/_10sdp"
    android:background="@color/White">


    <LinearLayout
        android:id="@+id/top_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_10sdp"
            android:minHeight="160dp"
            card_view:cardBackgroundColor="#f0f2f5"
            card_view:cardCornerRadius="@dimen/_4sdp"
            card_view:cardElevation="6sp"
            card_view:cardUseCompatPadding="true">

            <RelativeLayout
                android:id="@+id/rlBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/White"
                android:elevation="@dimen/_10sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_8sdp">


                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvDistributorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_4sdp"
                        android:text="@string/distributor_name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_18sdp" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/llArrival"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivArrivalImage"
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_80sdp"
                                android:scaleType="fitXY"
                                android:src="@drawable/logo" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:orientation="vertical">

                                <com.dhanuka.indhan.Fonts.Medium
                                    android:id="@+id/tvMeDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:singleLine="true"
                                    android:text="2021-12-21 12:34:00"
                                    android:textColor="#FF7C7474" />

                                <com.dhanuka.indhan.Fonts.Medium
                                    android:id="@+id/tvMeDescription"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:layout_marginTop="@dimen/_6sdp"
                                    android:layout_marginRight="@dimen/_10sdp"
                                    android:singleLine="true"
                                    android:text="@string/description"
                                    android:textColor="#FF837B7B" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llDeparture"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llArrival"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivDepartureImage"
                                android:layout_width="@dimen/_80sdp"
                                android:layout_height="@dimen/_80sdp"
                                android:scaleType="fitXY"
                                android:src="@drawable/logo" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:orientation="vertical">

                                <com.dhanuka.indhan.Fonts.Medium
                                    android:id="@+id/tvDepartureTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:singleLine="true"
                                    android:text="2021-12-21 12:34:00"
                                    android:textColor="#FF7C7474" />

                                <com.dhanuka.indhan.Fonts.Medium
                                    android:id="@+id/tvDepartureDescription"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start"
                                    android:layout_marginTop="@dimen/_6sdp"
                                    android:layout_marginRight="@dimen/_10sdp"
                                    android:singleLine="true"
                                    android:text="@string/description"
                                    android:textColor="#FF837B7B" />
                            </LinearLayout>

                        </LinearLayout>

                    </RelativeLayout>



                    <com.dhanuka.indhan.Fonts.Medium
                        android:id="@+id/tvActivityDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:singleLine="true"
                        android:text="Total Activity Duration - 2 Hours"
                        android:textColor="#FF837B7B" />

                </LinearLayout>
            </RelativeLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>


</RelativeLayout>