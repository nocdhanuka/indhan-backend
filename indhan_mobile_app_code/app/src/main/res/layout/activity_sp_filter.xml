<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/White"
    android:orientation="vertical"
    android:weightSum="12">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:elevation="@dimen/_10sdp">

            <LinearLayout
                android:id="@+id/iCross"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:gravity="center"
                tools:ignore="DuplicateIds">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_arrow_back"
                    android:padding="@dimen/_10sdp" />

            </LinearLayout>


            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/pd_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_toRightOf="@+id/iCross"
                android:text="Filter"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15sdp" />
            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/reset"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_marginRight="@dimen/_20sdp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="Reset"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13sdp" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/rcViewProdDes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="vertical"
        >

        <LinearLayout
            android:id="@+id/layout_s2"
            android:visibility="gone"

            android:layout_width="@dimen/_250sdp"
            android:layout_marginLeft="@dimen/_25sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_20sdp"
            android:orientation="vertical">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/s2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:drawableRight="@drawable/downarrow"
                android:text="Select S2"
                android:textColor="@color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginRight="@dimen/_14sdp"
                android:background="@color/darkgray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_s1"
            android:layout_width="@dimen/_250sdp"
            android:visibility="gone"

            android:layout_marginLeft="@dimen/_25sdp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_20sdp"
            android:orientation="vertical">

            <com.dhanuka.indhan.Fonts.Regular
                android:id="@+id/s1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:drawableRight="@drawable/downarrow"
                android:text="Select S1"
                android:textColor="@color/black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginRight="@dimen/_14sdp"
                android:background="@color/darkgray" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dhanuka.indhan.Fonts.Regular
            android:id="@+id/apply"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/ivCross"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_15sdp" />
    </com.google.android.material.appbar.AppBarLayout>
</LinearLayout>