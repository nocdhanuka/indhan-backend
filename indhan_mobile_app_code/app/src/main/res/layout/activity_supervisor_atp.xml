<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.dhanuka.indhan.Fonts.Regular
                    android:id="@+id/title_demo_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:ellipsize="end"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:maxLines="1"
                    android:padding="@dimen/_6sdp"
                    android:singleLine="true"
                    android:text="View ATP"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_16sdp" />
                <ImageView
                    android:id="@+id/imgFilter"
                    android:layout_width="@dimen/_20dp"
                    android:layout_height="@dimen/_20dp"
                    android:tint="@color/white"
                    android:layout_marginRight="@dimen/_15dp"
                    android:layout_marginTop="@dimen/_10dp"
                    app:srcCompat="@drawable/filter"/>

            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45dp"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/White"
                app:tabMaxWidth="0dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="@color/yello"
                app:tabTextAppearance="@style/LargeTabText"
                app:tabTextColor="@color/white_opacity" />


        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/viewPagerRerquest"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>